# Build artifacts and Python venv
*.pyc
__pycache__/
.env
.venv/
*.egg-info/
build/
dist/

# OS / IDE
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# PleOS APK binaries and decompiled sources — contractor IP protection
data/apks/
data/decompiled/

# Reports — per-APK private until report-finalisation review
# (directory itself NOT ignored so meta-analysis tables can opt-in via negation)
data/reports/*.json
data/reports/*.md
# Exception: meta-analysis aggregation tables (no PleOS source, GT-derived only)
!data/reports/aaos_mapping_table_*
!data/reports/tara_artifact_*

# PPT — private until report-finalisation review
*.pptx
*.pdf
pptx/

# Local-only logs / temp
*.log
.tmp/

# Internal working notes (작업 가이드 + 진척 추적, public 비공개)
CLAUDE.md
progress.md
next.md
docs/ppt_revision_guide.md

# Local identity (학번/이름/소속) — scripts 가 import 함
scripts/_author.json
scripts/_author.example.json

# Raw measurement notes (시점 스냅샷) — 보고서 인용용 로컬 보관, public 비공개
docs/archive/

# PPT 빌드 스크립트 — 학기 보고용 산출물, 파이프라인 재현 무관 → 로컬 only
scripts/build_ppt_v3.py
scripts/build_ppt_v3_1page.py

# Auto-regenerated per-APK summary md from entropy.py — JSON is source of truth
data/deobf/*.md
!data/deobf/README.md
