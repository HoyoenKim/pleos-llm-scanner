# Build artifacts and Python venv
*.pyc
__pycache__/
.env
.venv/
*.egg-info/
build/
dist/

# OS / IDE
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local-only evidence, binaries, generated DBs, and private inputs.
#
# Keep APKs, JADX output, raw PoC evidence, portable tools, native extracts, and
# vector DBs under one obvious bucket so the repository root stays readable and
# sensitive contractor/IP material is not accidentally staged.
data/_local/

# Backward-compatible ignores for pre-cleanup local folders. New scripts write
# under data/_local/, but these entries prevent old worktrees from leaking data.
data/apks/
data/decompiled/
data/native/
data/native_libs/
data/native_deep_dive/
data/rag/
data/runtime_poc_harness/
data/runtime_poc_recordings/
data/runtime_poc_final_demo/
data/runtime_poc_improved_demo/
data/runtime_poc_llm_boundary_demo/
data/poc_evidence/
tools/

# Reports are split by disclosure boundary.
# - aggregate/: tracked, GT-derived/public-safe summary tables
# - external/: tracked, public vulnerable corpus reports
# - public/: tracked, masked PleOS public copies
# - local/per_apk/runtime/native/rag: ignored private or generated evidence
data/reports/*.json
data/reports/*.md
!data/reports/README.md
data/reports/local/
data/reports/per_apk_local/
data/reports/runtime_local/
data/reports/native_local/
data/reports/rag_local/
data/reports/_raw/
data/reports/prompt_leak_attack_poc/
data/reports/local/codex_multimodel/
data/reports/rag_local/rag_end_to_end/

# PPT and source presentation decks are private until report-finalisation review.
*.pptx
*.pdf
pptx/

# Local-only logs / temp
*.log
.tmp/

# Internal working notes (task guide + progress tracking, not public-facing).
CLAUDE.md
progress.md
next.md
docs/ppt_revision_guide.md
docs/archive/

# Local identity (student/name/email), imported by PPT scripts when present.
scripts/_author.example.json
scripts/_author.json
scripts/presentation/_author.example.json
scripts/presentation/_author.json

# PPT build helpers are local-only because generated decks are not reproducible
# without the private source decks and local identity file.
scripts/build_ppt_*.py
scripts/presentation/build_ppt_*.py

# Auto-regenerated per-APK summary md from entropy.py. JSON is source of truth.
data/deobf/*.md
!data/deobf/README.md
